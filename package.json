{
	"name": "portfolio",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "playwright test",
		"check": "pnpm i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.25.4",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^5",
		"@tailwindcss/vite": "^4",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4",
		"tslib": "^2.4.1",
		"typescript": "^5.9.3",
		"vite": "^6.4.3"
	},
	"type": "module",
	"dependencies": {
		"lenis": "^1.3.26",
		"three": "^0.186.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"@sveltejs/kit",
			"svelte-preprocess"
		]
	},
	"packageManager": "pnpm@10.6.4"
}
